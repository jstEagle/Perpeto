{
  "name": "perpeto",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "scripts": {
    "setup": "npm install --no-audit --no-fund && node scripts/runtime.mjs setup",
    "build": "node scripts/runtime.mjs build",
    "start": "node scripts/runtime.mjs start",
    "test": "node scripts/test.mjs",
    "test:upstream": "node scripts/runtime.mjs test",
    "verify:upstream": "node scripts/check-upstream.mjs",
    "runtime:help": "node scripts/runtime.mjs help",
    "smoke:messaging": "node scripts/smoke-messaging.mjs",
    "test:e2e": "node --test packages/factory-e2e/test/build-run.test.js packages/factory-e2e/test/architect.test.js"
  },
  "workspaces": [
    "packages/*"
  ]
}
