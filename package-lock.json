{
  "name": "perpeto",
  "version": "0.0.1",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "perpeto",
      "version": "0.0.1",
      "workspaces": [
        "apps/hub",
        "apps/node",
        "apps/cli",
        "packages/*",
        "tests/*"
      ],
      "engines": {
        "node": ">=24.13.1 <25"
      }
    },
    "apps/cli": {
      "name": "@perpeto/cli",
      "version": "0.0.1",
      "dependencies": {
        "@perpeto/hub": "*",
        "@perpeto/node": "*"
      },
      "bin": {
        "perpeto": "bin/perpeto.js"
      },
      "engines": {
        "node": ">=24.13.1 <25"
      }
    },
    "apps/hub": {
      "name": "@perpeto/hub",
      "version": "0.1.0",
      "dependencies": {
        "@perpeto/delivery": "*",
        "@perpeto/messaging": "*",
        "@perpeto/workflow": "*"
      },
      "bin": {
        "perpeto-hub": "bin/perpeto-hub.js"
      },
      "engines": {
        "node": ">=24.13.1 <25"
      }
    },
    "apps/node": {
      "name": "@perpeto/node",
      "version": "0.1.0",
      "dependencies": {
        "@perpeto/accounts": "*"
      },
      "bin": {
        "perpeto-node": "bin/perpeto-node.js"
      },
      "engines": {
        "node": ">=24.13.1 <25"
      }
    },
    "node_modules/@perpeto/accounts": {
      "resolved": "packages/accounts",
      "link": true
    },
    "node_modules/@perpeto/cli": {
      "resolved": "apps/cli",
      "link": true
    },
    "node_modules/@perpeto/delivery": {
      "resolved": "packages/delivery",
      "link": true
    },
    "node_modules/@perpeto/design-tokens": {
      "resolved": "packages/design-tokens",
      "link": true
    },
    "node_modules/@perpeto/e2e": {
      "resolved": "tests/e2e",
      "link": true
    },
    "node_modules/@perpeto/hub": {
      "resolved": "apps/hub",
      "link": true
    },
    "node_modules/@perpeto/messaging": {
      "resolved": "packages/messaging",
      "link": true
    },
    "node_modules/@perpeto/node": {
      "resolved": "apps/node",
      "link": true
    },
    "node_modules/@perpeto/sdk": {
      "resolved": "packages/sdk",
      "link": true
    },
    "node_modules/@perpeto/t3-executor": {
      "resolved": "packages/t3-executor",
      "link": true
    },
    "node_modules/@perpeto/workflow": {
      "resolved": "packages/workflow",
      "link": true
    },
    "packages/accounts": {
      "name": "@perpeto/accounts",
      "version": "0.1.0",
      "engines": {
        "node": ">=24.13.1 <25"
      }
    },
    "packages/delivery": {
      "name": "@perpeto/delivery",
      "version": "0.1.0",
      "engines": {
        "node": ">=24.13.1 <25"
      }
    },
    "packages/design-tokens": {
      "name": "@perpeto/design-tokens",
      "version": "0.1.0",
      "engines": {
        "node": ">=24.0.0"
      }
    },
    "packages/messaging": {
      "name": "@perpeto/messaging",
      "version": "0.1.0",
      "engines": {
        "node": ">=24.0.0"
      }
    },
    "packages/sdk": {
      "name": "@perpeto/sdk",
      "version": "0.1.0",
      "bin": {
        "perpeto-messages": "src/cli.js"
      },
      "engines": {
        "node": ">=24.0.0"
      }
    },
    "packages/t3-executor": {
      "name": "@perpeto/t3-executor",
      "version": "0.1.0",
      "devDependencies": {
        "@perpeto/node": "*"
      },
      "engines": {
        "node": ">=24.0.0"
      }
    },
    "packages/workflow": {
      "name": "@perpeto/workflow",
      "version": "0.1.0",
      "engines": {
        "node": ">=24.0.0"
      }
    },
    "tests/e2e": {
      "name": "@perpeto/e2e",
      "version": "0.1.0",
      "dependencies": {
        "@perpeto/delivery": "*",
        "@perpeto/hub": "*",
        "@perpeto/node": "*",
        "@perpeto/sdk": "*",
        "@perpeto/workflow": "*"
      },
      "engines": {
        "node": ">=24.13.1 <25"
      }
    }
  }
}
