{
  "text": [12, 13, 14, 16, 20, 24, 28, 32],
  "display": [40, 48, 56, 64, 72],
  "leading": {
    "body": 1.5,
    "heading": 1.2,
    "display": 1.05,
    "compact": 1.35
  },
  "weight": {
    "regular": 400,
    "medium": 500,
    "semibold": 600
  },
  "tracking": {
    "heading": "-0.015em",
    "display": "-0.03em"
  },
  "spaceSteps": 24,
  "control": {
    "sm": 32,
    "md": 40,
    "lg": 48
  },
  "icon": {
    "sm": 16,
    "md": 20,
    "tile": 36
  },
  "stroke": {
    "hairline": 1,
    "edge": 1.25,
    "edgeActive": 1.5,
    "selection": 1.5,
    "focus": 2,
    "focusOffset": 2
  },
  "indicator": {
    "dot": 8,
    "halo": 4
  },
  "editor": {
    "dotSpacing": 24,
    "dotSize": 1.5,
    "port": 8,
    "nodeWidth": 208,
    "nodeGapX": 64,
    "nodeGapY": 72,
    "edgeCorner": 12
  },
  "derivedColor": {
    "action-hover": { "mix": ["action", "surface", 0.14] },
    "action-pressed": { "mix": ["action", "surface", 0.06] },
    "surface-hover": { "mix": ["surface", "surface-subtle", 0.6] },
    "canvas-strong": { "mix": ["canvas", "grey-100", 0.6] },
    "accent-wash": { "mix": ["surface", "accent", 0.16], "note": "Halo around the live dot only." },
    "error-wash": { "mix": ["surface", "error", 0.06] },
    "editor-canvas": { "mix": ["canvas", "surface", 0.5] },
    "editor-dot": { "mix": ["canvas", "grey-200", 0.6] },
    "editor-edge": { "alias": "grey-400" },
    "editor-edge-active": { "alias": "grey-600" },
    "chart": { "alias": "grey-400" },
    "chart-strong": { "alias": "ink" },
    "chart-quiet": { "alias": "grey-100" },
    "success-wash": { "alias": "surface-subtle", "legacy": true },
    "warning-wash": { "alias": "surface-subtle", "legacy": true },
    "grid-minor": { "alias": "editor-dot", "legacy": true },
    "grid-major": { "alias": "editor-dot", "legacy": true }
  },
  "contrast": {
    "text": [
      ["ink", "canvas"],
      ["ink", "surface"],
      ["ink", "surface-subtle"],
      ["ink", "surface-hover"],
      ["ink", "canvas-strong"],
      ["ink-soft", "canvas"],
      ["ink-soft", "surface"],
      ["ink-soft", "surface-subtle"],
      ["muted", "canvas"],
      ["muted", "surface"],
      ["muted", "surface-subtle"],
      ["muted", "surface-hover"],
      ["muted", "canvas-strong"],
      ["muted", "editor-canvas"],
      ["on-action", "action"],
      ["on-action", "action-hover"],
      ["on-action", "action-pressed"],
      ["error", "surface"],
      ["error", "canvas"],
      ["error", "error-wash"]
    ],
    "nonText": [
      ["control-border", "surface"],
      ["control-border", "canvas"],
      ["faint", "surface"],
      ["faint", "canvas"],
      ["focus", "canvas"],
      ["focus", "surface"],
      ["accent", "surface"],
      ["accent", "canvas"],
      ["accent", "editor-canvas"],
      ["editor-edge", "editor-canvas"],
      ["editor-edge", "surface"],
      ["chart", "surface"],
      ["error", "surface"]
    ]
  }
}
