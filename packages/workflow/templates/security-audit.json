{
  "schema": "perpeto.workflow/1",
  "nodes": [
    {
      "id": "input",
      "type": "input",
      "label": "Input",
      "position": {
        "x": 0,
        "y": 160
      },
      "config": {
        "source": "manual"
      }
    },
    {
      "id": "auditor",
      "type": "planner",
      "label": "Auditor",
      "position": {
        "x": 200,
        "y": 160
      },
      "config": {
        "harness": {
          "provider": "codex",
          "model": "gpt-6-astra"
        },
        "prompt": "Audit the authorized repository scope for security weaknesses. Propose evidence-backed findings with severity, location, impact and a safe verification plan. Avoid duplicate findings. Split along file/module boundaries and declare touches: string[] per item, including shared entry points and manifests.",
        "concurrency": 1,
        "policy": {
          "maxSubagents": 0
        },
        "retry": {
          "maxAttempts": 3,
          "backoffSec": 30
        },
        "maxItems": 3,
        "serializeOverlappingTouches": true
      }
    },
    {
      "id": "delivery-loop",
      "type": "loop",
      "label": "Delivery loop",
      "position": {
        "x": 400,
        "y": 160
      },
      "config": {
        "until": "ci-pass",
        "maxIterations": 3,
        "onExhausted": "triage"
      }
    },
    {
      "id": "finding-verifier",
      "type": "agent",
      "label": "Finding verifier",
      "position": {
        "x": 600,
        "y": 160
      },
      "config": {
        "harness": {
          "provider": "claudeAgent",
          "model": "claude-sonnet-5-5"
        },
        "prompt": "Verify the finding with a safe regression test in the authorized environment. Reject false positives by reporting blocked with evidence. Pass the branch and full head SHA to the fixer.",
        "concurrency": 2,
        "policy": {
          "maxSubagents": 0
        },
        "retry": {
          "maxAttempts": 3,
          "backoffSec": 30
        },
        "onExhausted": "triage"
      }
    },
    {
      "id": "fixer",
      "type": "agent",
      "label": "Fixer",
      "position": {
        "x": 800,
        "y": 160
      },
      "config": {
        "harness": {
          "provider": "codex",
          "model": "gpt-6-astra"
        },
        "prompt": "Fix only the verified finding, add regression coverage, and publish the branch with delivery reference and full head SHA. Address attached feedback first.",
        "concurrency": 2,
        "policy": {
          "maxSubagents": 0
        },
        "retry": {
          "maxAttempts": 3,
          "backoffSec": 30
        },
        "onExhausted": "triage"
      }
    },
    {
      "id": "reviewer",
      "type": "review",
      "label": "Reviewer",
      "position": {
        "x": 1000,
        "y": 160
      },
      "config": {
        "harness": {
          "provider": "codex",
          "model": "gpt-6-astra"
        },
        "prompt": "Review exploit evidence, fix correctness, security boundaries and regressions. Report verdict pass or fail with evidence.",
        "concurrency": 1,
        "policy": {
          "maxSubagents": 0
        },
        "retry": {
          "maxAttempts": 3,
          "backoffSec": 30
        },
        "onExhausted": "triage"
      }
    },
    {
      "id": "ci",
      "type": "ci",
      "label": "Ci",
      "position": {
        "x": 1200,
        "y": 160
      },
      "config": {
        "steps": [
          {
            "name": "install",
            "run": "npm ci",
            "timeoutSec": 900
          },
          {
            "name": "test",
            "run": "npm test",
            "timeoutSec": 900
          }
        ],
        "retry": {
          "maxAttempts": 2,
          "backoffSec": 30
        },
        "onExhausted": "triage"
      }
    },
    {
      "id": "merge",
      "type": "merge-queue",
      "label": "Merge",
      "position": {
        "x": 1400,
        "y": 160
      },
      "config": {
        "strategy": "serial",
        "method": "squash",
        "requiredChecks": [
          "test"
        ],
        "onConflict": "rebase",
        "rebaseReview": "changed"
      }
    },
    {
      "id": "done",
      "type": "output",
      "label": "Done",
      "position": {
        "x": 1600,
        "y": 160
      },
      "config": {}
    },
    {
      "id": "triage",
      "type": "human",
      "label": "Triage",
      "position": {
        "x": 1800,
        "y": 160
      },
      "config": {
        "prompt": "Review the evidence and scope. Pass with guidance to retry; fail to stop this item."
      }
    }
  ],
  "edges": [
    {
      "id": "input-next",
      "kind": "flow",
      "from": {
        "node": "input"
      },
      "to": {
        "node": "auditor"
      }
    },
    {
      "id": "auditor-next",
      "kind": "flow",
      "from": {
        "node": "auditor"
      },
      "to": {
        "node": "delivery-loop"
      }
    },
    {
      "id": "delivery-loop-next",
      "kind": "flow",
      "from": {
        "node": "delivery-loop"
      },
      "to": {
        "node": "finding-verifier"
      }
    },
    {
      "id": "finding-verifier-next",
      "kind": "flow",
      "from": {
        "node": "finding-verifier"
      },
      "to": {
        "node": "fixer"
      }
    },
    {
      "id": "fixer-next",
      "kind": "flow",
      "from": {
        "node": "fixer"
      },
      "to": {
        "node": "reviewer"
      }
    },
    {
      "id": "reviewer-pass",
      "kind": "flow",
      "from": {
        "node": "reviewer",
        "port": "pass"
      },
      "to": {
        "node": "ci"
      }
    },
    {
      "id": "reviewer-fail",
      "kind": "flow",
      "from": {
        "node": "reviewer",
        "port": "fail"
      },
      "to": {
        "node": "delivery-loop"
      }
    },
    {
      "id": "ci-pass",
      "kind": "flow",
      "from": {
        "node": "ci",
        "port": "pass"
      },
      "to": {
        "node": "merge"
      }
    },
    {
      "id": "ci-fail",
      "kind": "flow",
      "from": {
        "node": "ci",
        "port": "fail"
      },
      "to": {
        "node": "delivery-loop"
      }
    },
    {
      "id": "merge-pass",
      "kind": "flow",
      "from": {
        "node": "merge",
        "port": "pass"
      },
      "to": {
        "node": "done"
      }
    },
    {
      "id": "merge-fail",
      "kind": "flow",
      "from": {
        "node": "merge",
        "port": "fail"
      },
      "to": {
        "node": "delivery-loop"
      }
    },
    {
      "id": "triage-pass",
      "kind": "flow",
      "from": {
        "node": "triage",
        "port": "pass"
      },
      "to": {
        "node": "delivery-loop"
      }
    }
  ]
}
